{
  "name": "figma-render",
  "private": true,
  "version": "0.1.0",
  "description": "Render Figma design files to interactive HTML/CSS in the browser.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @figma-render/server --filter @figma-render/web dev",
    "dev:server": "pnpm --filter @figma-render/server dev",
    "dev:web": "pnpm --filter @figma-render/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10"
  },
  "engines": {
    "node": ">=20"
  }
}
